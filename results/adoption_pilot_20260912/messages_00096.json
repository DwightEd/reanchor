    {
      "role": "prompt_other",
      "start": 30,
      "stop": 37,
      "text": "Briefly answer the following question:\n"
    },
    {
      "role": "prompt_other",
      "start": 37,
      "stop": 43,
      "text": "how to cook brats\n"
    },
    {
      "role": "prompt_other",
      "start": 43,
      "stop": 59,
      "text": "Bear in mind that your response should be strictly based on the following three passages:\n"
    },
    {
      "role": "prompt_other",
      "start": 59,
      "stop": 64,
      "text": "passage 1:"
    },
    {
      "role": "source",
      "start": 64,
      "stop": 79,
      "text": "1 Reduce heat to medium and cook another 10 to 12 minutes."
    },
    {
      "role": "source",
      "start": 79,
      "stop": 103,
      "text": " 2  Remove the bratwurst from the beer mixture; reduce heat to low, and continue cooking the onions."
    },
    {
      "role": "source",
      "start": 103,
      "stop": 128,
      "text": " 3  Cook the bratwurst on the preheated grill, turning once, 5 to 10 minutes."
    },
    {
      "role": "source",
      "start": 128,
      "stop": 142,
      "text": " 4  Serve with the beer mixture as a topping or side."
    },
    {
      "role": "source",
      "start": 142,
      "stop": 145,
      "text": "irections."
    },
    {
      "role": "source",
      "start": 145,
      "stop": 147,
      "text": " Prep."
    },
    {
      "role": "source",
      "start": 147,
      "stop": 149,
      "text": " Cook."
    },
    {
      "role": "source",
      "start": 149,
      "stop": 152,
      "text": " Ready In."
    },
    {
      "role": "source",
      "start": 152,
      "stop": 165,
      "text": " 1  Preheat an outdoor grill for medium-high heat."
    },
    {
      "role": "source",
      "start": 165,
      "stop": 175,
      "text": " 2  When hot, lightly oil grate."
    },
    {
      "role": "source",
      "start": 175,
      "stop": 193,
      "text": " 3  Combine the beer and onions in a large pot; bring to a boil."
    },
    {
      "role": "source",
      "start": 193,
      "stop": 220,
      "text": " 4  Submerge the bratwurst in the beer; add the red pepper flakes, garlic powder, salt, and pepper.\n\n"
    },
    {
      "role": "prompt_other",
      "start": 220,
      "stop": 225,
      "text": "passage 2:"
    },
    {
      "role": "source",
      "start": 225,
      "stop": 242,
      "text": "1 Prick bratwurst with fork to prevent them from exploding as they cook."
    },
    {
      "role": "source",
      "start": 242,
      "stop": 260,
      "text": " 2  Place in a large stock pot with the onions, butter, and beer."
    },
    {
      "role": "source",
      "start": 260,
      "stop": 279,
      "text": " 3  Place pot over medium heat, and simmer for 15 to 20 minutes."
    },
    {
      "role": "source",
      "start": 279,
      "stop": 289,
      "text": "4  Preheat grill for medium-high heat."
    },
    {
      "role": "source",
      "start": 289,
      "stop": 305,
      "text": " Place pot over medium heat, and simmer for 15 to 20 minutes."
    },
    {
      "role": "source",
      "start": 305,
      "stop": 316,
      "text": " 2  Preheat grill for medium-high heat."
    },
    {
      "role": "source",
      "start": 316,
      "stop": 324,
      "text": " 3  Lightly oil grate."
    },
    {
      "role": "source",
      "start": 324,
      "stop": 350,
      "text": " 4  Cook bratwurst on preheated grill for 10 to 14 minutes, turning occasionally to brown evenly.\n\n"
    },
    {
